# ============================================================
# CRM Admin Dashboard — Production Environment Variables
# ============================================================
# Copy this file to the project root as .env before deploying:
#   cp deploy/.env.production.example .env
#   nano .env
# ============================================================

# ----- Application -----
PROJECT_NAME="CRM System"
ENVIRONMENT="production"
SECRET_KEY="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----- PostgreSQL -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=crm_project

# ----- CORS -----
# Set to your domain in production (comma-separated for multiple)
# Example: "https://crm.yourdomain.com,https://www.yourdomain.com"
CORS_ORIGINS="*"

# ----- AWS S3 (for file/image uploads) -----
# Get these from AWS IAM console (see deploy/AWS_SETUP.md)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_REGION=ap-south-1
S3_BUCKET_NAME=crm-dashboard-uploads

# Optional: CloudFront CDN domain (leave empty if not using CloudFront)
S3_CDN_DOMAIN=
